# ===========================
# Global Ignore
# ===========================
.DS_Store
Thumbs.db
*.log
logs/
*.sqlite3
*.db

# ===========================
# Python Backend Ignore (backend/app)
# ===========================
# Caches and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environments
.env
venv/
env/
.venv/

# Database files specific to the backend
backend/app/instance/
backend/app/*.sqlite3
backend/app/notes_app.db
# notes_app.db is already listed above but being more specific is safer

# ===========================
# Node / Next.js Frontend Ignore (notes-frontend)
# ===========================
# Dependencies (node_modules)
notes-frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build folders
notes-frontend/.next/
notes-frontend/out/

# Environment files - **These will prevent the actual frontend .env files from being tracked**
notes-frontend/.env
notes-frontend/.env.local
notes-frontend/.env.*.local

# ===========================
# IDE Ignore
# ===========================
.vscode/
.idea/

# ===========================
# OS Ignore
# ===========================
*.swp
*.swo